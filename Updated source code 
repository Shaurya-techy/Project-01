
#include <stdio.h>

void analyzePatient(float weight, float height, int age,
                    int systolicBP, float *bmi, int *riskCode)
{
    float heightInMeters = height / 100.0;

    // Calculate BMI using the pointer
    *bmi = weight / (heightInMeters * heightInMeters);

    // Determine illustrative risk category
    if (systolicBP >= 140 || age >= 60)
        *riskCode = 3;
    else if (systolicBP >= 120 || age >= 40)
        *riskCode = 2;
    else
        *riskCode = 1;
}

int main()
{
    float weight, height, bmi;
    int age, systolicBP, riskCode;

    printf("===== PATIENT HEALTH ANALYSIS =====\n\n");

    printf("Enter weight (kg): ");
    if (scanf("%f", &weight) != 1)
        return 1;

    printf("Enter height (cm): ");
    if (scanf("%f", &height) != 1)
        return 1;

    printf("Enter age (years): ");
    if (scanf("%d", &age) != 1)
        return 1;

    printf("Enter systolic BP (mmHg): ");
    if (scanf("%d", &systolicBP) != 1)
        return 1;

    if (weight <= 0 || height <= 0 ||
        age <= 0 || systolicBP <= 0)
    {
        printf("Invalid input!\n");
        return 1;
    }

    // CALL BY REFERENCE: pass addresses of output variables
    analyzePatient(weight, height, age, systolicBP,
                   &bmi, &riskCode);

    printf("\n===== PATIENT REPORT =====\n");
    printf("Weight: %.2f kg\n", weight);
    printf("Height: %.2f cm\n", height);
    printf("Age: %d years\n", age);
    printf("Systolic BP: %d mmHg\n", systolicBP);

    printf("\n===== ANALYSIS RESULTS =====\n");
    printf("BMI: %.2f\n", bmi);

    if (riskCode == 3)
        printf("Risk Category: High Risk\n");
    else if (riskCode == 2)
        printf("Risk Category: Moderate Risk\n");
    else
        printf("Risk Category: Low Risk\n");

    printf("Risk Code: %d\n", riskCode);
    printf("\n===== END OF REPORT =====\n");

    return 0;
}
