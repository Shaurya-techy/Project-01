
#include <stdio.h>

void getDetails(float *weight, float *height,
                int *age, int *bp)
{
    printf("Enter weight (kg): ");
    scanf("%f", weight);

    printf("Enter height (cm): ");
    scanf("%f", height);

    printf("Enter age (years): ");
    scanf("%d", age);

    printf("Enter systolic BP (mmHg): ");
    scanf("%d", bp);
}

void calculateAnalysis(float *weight, float *height,
                       float *bmi, int *riskCode)
{
    *bmi = *weight / ((*height / 100.0f) *
                      (*height / 100.0f));

    if (*bmi < 18.5f)
        *riskCode = 2;
    else if (*bmi < 25.0f)
        *riskCode = 1;
    else if (*bmi < 30.0f)
        *riskCode = 2;
    else
        *riskCode = 3;
}

void displayReport(float *weight, float *height,
                   int *age, int *bp, float *bmi,
                   int *riskCode)
{
    printf("\n===== PATIENT REPORT =====\n");
    printf("Weight: %.2f kg\n", *weight);
    printf("Height: %.2f cm\n", *height);
    printf("Age: %d years\n", *age);
    printf("Systolic BP: %d mmHg\n", *bp);

    printf("\n===== ANALYSIS RESULTS =====\n");
    printf("BMI: %.2f\n", *bmi);

    if (*riskCode == 1)
        printf("Risk Category: Low Risk\n");
    else if (*riskCode == 2)
        printf("Risk Category: Moderate Risk\n");
    else
        printf("Risk Category: High Risk\n");

    printf("Risk Code: %d\n", *riskCode);
    printf("\n===== END OF REPORT =====\n");
}

int main(void)
{
    float weight, height, bmi;
    int age, bp, riskCode;

    printf("===== PATIENT HEALTH ANALYSIS =====\n\n");

    getDetails(&weight, &height, &age, &bp);

    calculateAnalysis(&weight, &height, &bmi, &riskCode);

    displayReport(&weight, &height, &age, &bp,
                  &bmi, &riskCode);

    return 0;
}
